{
  "version": 2,
  "builds": [
    { "src": "pamoja_vote/wsgi.py", "use": "@vercel/python" },
    { "src": "build_files.sh", "use": "@vercel/static-build", "config": { "distDir": "backend/staticfiles" } }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "backend/staticfiles/$1"
    },
    {
      "src": "/(.*)",
      "dest": "pamoja_vote/wsgi.py"
    }
  ]
}
