{
  "version": 2,
  "builds": [
    {
      "src": "pamoja_vote/wsgi.py",
      "use": "@vercel/python",
      "config": { "maxLambdaSize": "50mb" }
    }
  ],
  "routes": [
    { "src": "^/static/(.*)$", "dest": "/staticfiles/$1" },
    { "src": "/media/(.*)", "dest": "/media/$1" },
    { "src": "/(.*)", "dest": "pamoja_vote/wsgi.py" }
  ],
  "buildCommand": "bash build_files.sh"
}
