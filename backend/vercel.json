{
  "version": 2,
  "buildCommand": "bash build_files.sh",
  "builds": [
    {
      "src": "pamoja_vote/wsgi.py",
      "use": "@vercel/python",
      "config": { "maxLambdaSize": "50mb" }
    },
    {
      "src": "build_files.sh",
      "use": "@vercel/static-build",
      "config": { "distDir": "staticfiles" }
    }
  ],
  "routes": [
    { "src": "^/static/(.*)$", "dest": "/staticfiles/$1" },
    { "src": "^/media/(.*)$", "dest": "/media/$1" },
    { "src": "^/api/(.*)$", "dest": "pamoja_vote/wsgi.py" },
    { "src": "^/admin/(.*)$", "dest": "pamoja_vote/wsgi.py" },
    { "src": "^/api/docs/(.*)$", "dest": "pamoja_vote/wsgi.py" }
  ],
  "outputDirectory": "staticfiles"
}
